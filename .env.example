# Copy this file to .env and fill in values before running benchmark_azure.py

# Azure Speech API credentials (only needed for benchmarking, not for SpeakRight itself)
AZURE_SPEECH_KEY=your_key_here
AZURE_SPEECH_REGION=eastus

# SpeakRight model settings
SPEAKRIGHT_MODEL=facebook/wav2vec2-base
SPEAKRIGHT_DEVICE=cpu     # or "cuda"
